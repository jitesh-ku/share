def read_pdf(file):
    pdf_reader = PyPDF2.PdfReader(file)
    text = ""
    for page in pdf_reader.pages:
        text += page.extract_text() + "\n"
    return text

def read_docx(file):
    return docx2txt.process(file)

def extract_text(file):
    if file.name.endswith('.pdf'):
        return read_pdf(file)
    elif file.name.endswith('.docx'):
        return read_docx(file)
    elif file.name.endswith('.txt'):
        return file.read().decode("utf-8")
    else:
        return ""

def get_embedding(text):
    return model.encode(text, convert_to_tensor=True)

def extract_skills(text):
    text = text.lower()
    tokens = re.findall(r'\b\w[\w+.#/:-]*\b', text)
    extracted = set()

    # Match tokens against COMMON_SKILLS
    for skill in COMMON_SKILLS:
        for token in tokens:
            if skill in token:
                extracted.add(skill)
                break

    return list(extracted)

def skill_overlap_score(resume_skills, jd_skills):
    matched = set(resume_skills).intersection(set(jd_skills))
    return len(matched) / max(len(jd_skills), 1)

def generate_wordcloud(text):
    wc = WordCloud(width=500, height=50, background_color='white').generate(text)
    buf = BytesIO()
    wc.to_image().save(buf, format='PNG')
    byte_im = buf.getvalue()
    return base64.b64encode(byte_im).decode('utf-8')

def get_resume_feedback(text):
    prompt = f"""
    Analyze the following resume and provide suggestions to improve it. Focus on formatting, skills, clarity, and alignment with software/tech job roles:

    {text[:3000]}
    """
    try:
        response = openai.ChatCompletion.create(
            model="gpt-4",
            messages=[{"role": "user", "content": prompt}]
        )
        return response.choices[0].message.content
    except Exception as e:
        return f"Error: {e}"

def match_resumes_to_jobs(resume_texts, job_texts):
    results = []
    resume_embeddings = [get_embedding(text) for text in resume_texts]
    job_embeddings = [get_embedding(text) for text in job_texts]
    resume_skills_list = [extract_skills(text) for text in resume_texts]
    job_skills_list = [extract_skills(text) for text in job_texts]

    for i, (r_text, r_emb, r_skills) in enumerate(zip(resume_texts, resume_embeddings, resume_skills_list)):
        scores = []
        for j, (j_text, j_emb, j_skills) in enumerate(zip(job_texts, job_embeddings, job_skills_list)):
            semantic_score = util.cos_sim(r_emb, j_emb).item()
            skill_score = skill_overlap_score(r_skills, j_skills)
            combined_score = 0.5 * semantic_score + 0.5 * skill_score
            scores.append((f"JD_{j+1}", combined_score, semantic_score, skill_score))
        results.append((f"Resume_{i+1}", scores, r_skills))
    return results

def export_pdf(resume_id, match_data, skills, feedback):
    pdf = FPDF()
    pdf.add_page()
    pdf.set_font("Arial", 'B', 16)
    pdf.cell(0, 10, f"Match Report: {resume_id}", ln=True)

    pdf.set_font("Arial", '', 12)
    pdf.cell(0, 10, "\nBest Matches:", ln=True)
    for jd, combined, sem, skill in match_data:
        pdf.cell(0, 10, f"- {jd}: Final Score={combined:.2f}, Semantic={sem:.2f}, Skills={skill:.2f}", ln=True)

    pdf.cell(0, 10, "\nExtracted Skills:", ln=True)
    pdf.set_font("Arial", 'I', 12)
    pdf.multi_cell(0, 10, ', '.join(skills))

    pdf.set_font("Arial", '', 12)
    pdf.cell(0, 10, "\nGPT Feedback:", ln=True)
    pdf.set_font("Arial", '', 11)
    pdf.multi_cell(0, 10, feedback)

    output_path = f"match_report_{resume_id}.pdf"
    pdf.output(output_path)
    return output_path

