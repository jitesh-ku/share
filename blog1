def get_file_download_link(file_path, link_text, mime_type="text/html"):
    with open(file_path, "rb") as f:
        data = f.read()
    b64 = base64.b64encode(data).decode()
    href = f'<a href="data:{mime_type};base64,{b64}" download="{file_path}" target="_blank">{link_text}</a>'
    return href

# Save blog HTML to a local "static" folder
def export_to_static_html(title, blog_content, keywords):
    safe_title = title.lower().replace(" ", "_").replace("/", "_")
    html_filename = f"{safe_title}.html"
    static_dir = "static"
    os.makedirs(static_dir, exist_ok=True)

    html_path = os.path.join(static_dir, html_filename)
    with open(html_path, "w", encoding="utf-8") as f:
        html_body = f"<h1>{title}</h1><p><b>Keywords:</b> {', '.join(keywords)}</p><p>{blog_content.replace('\\n', '<br>')}</p>"
        f.write(html_body)
    print(html_path)
    print(html_filename)
    return html_path, html_filename

