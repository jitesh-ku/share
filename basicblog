# Function to fetch related keywords from DuckDuckGo
def fetch_related_keywords(scan_topic):
    url = f"https://duckduckgo.com/html/?q={scan_topic}"
    response = requests.get(url)
    print(response.text)
    soup = BeautifulSoup(response.text, 'html.parser')
    results = [a.get_text() for a in soup.select(".result__a")]
    print(results)
    fetched_keywords = list(set([line.split(" - ")[0] for line in results if scan_topic.lower() not in line.lower()]))
    print(fetched_keywords)
    return fetched_keywords[:5] if fetched_keywords else [scan_topic]


# Function to analyze SEO factors
def analyze_seo_factors(content):
    score = textstat.flesch_reading_ease(content)
    word_count = len(content.split())
    return {"readability_score": score, "word_count": word_count}


# Function to export blog to markdown
def export_to_markdown(title, content, fetched_keywords):
    safe_title = title.lower().replace(" ", "_").replace("/", "_")
    export_filename = f"{safe_title}.md"
    with open(export_filename, "w", encoding="utf-8") as file:
        file.write(f"# {title}\n\n")
        file.write(f"**Keywords**: {', '.join(fetched_keywords)}\n\n")
        file.write(content)
    return export_filename


