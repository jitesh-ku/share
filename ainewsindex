<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>📰 AI News Summarizer</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-2 sidebar py-4">
      <h2 class="text-left mb-4">Select News Sources</h2>
      <br/><br/><br/>
      <form method="POST">
        {% for source in rss_feeds %}
          <div class="form-check mb-2 ps-3">
            <input class="form-check-input" type="checkbox" name="sources" value="{{ source }}"
              {% if source in selected_sources %}checked{% endif %}
              onchange="this.form.submit();">
            <h4 class="form-check-label">{{ source }}</h4>
          </div>
        {% endfor %}
      </form>
    </div>

    <!-- Main Content -->
    <div class="col-10 content p-4">
      <h2 class="mb-4">Top Headlines by AI Pulse</h2>

      {% for source in selected_sources %}
        {% set entries = articles.get(source, []) %}
        <h3 class="mt-4">{{ source }}</h3>
        {% for entry in entries %}
          <div class="card mb-3 shadow-sm">
            <div class="card-body">
              <h5 class="card-title">{{ entry.title }}</h5>
              <p class="card-subtitle mb-2 text-muted">{{ entry.published or "No Date" }}</p>

              <!-- Read Full Article Link -->
              <div class="mb-2">
                <a href="{{ entry.link }}" target="_blank" class="btn btn-sm btn-link px-0">🔗 Read Full Article</a>
              </div>

              <!-- Summary Button Form -->
              <form method="POST" class="mb-2">
                {% for s in selected_sources %}
                  <input type="hidden" name="sources" value="{{ s }}">
                {% endfor %}
                <button type="submit" name="summary_{{ source }}_{{ entry.link }}" value="1"
                        class="btn btn-sm btn-outline-primary">
                  💡 View AI Generated Summary
                </button>
              </form>

              <!-- Show AI Summary if exists -->
              {% if summaries.get(source) and summaries[source].get(entry.link) %}
                <div class="alert alert-info mt-2">
                  {{ summaries[source][entry.link] }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>
</body>
</html>
